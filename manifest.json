{
  "name": "Viridis – Sustainable Shopping Assistant",
  "description": "Shows sustainability scores and greener alternatives on clothing product pages.",
  "version": "0.1.0",
  "manifest_version": 3,

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/contentScript.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },

  "host_permissions": [
    "https://api.openai.com/*",
    "<all_urls>"
  ],
  "permissions": ["storage", "activeTab", "scripting"]
}
