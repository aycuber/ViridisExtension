{
  "compilerOptions": {
    /* ---------- language / emit ---------- */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* ---------- type safety ---------- */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* ---------- JSX / React ---------- */
    "jsx": "react-jsx",

    /* ---------- libs & global types ---------- */
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "types": [
      "chrome-types",   // ⇦ adds MV3 ‘chrome.*’ globals
      "vite/client"     // ⇦ keeps import.meta from Vite happy
      /* "jest" */      // ⇦ uncomment if you compile Jest tests
    ]
  },

  /* ---------- file globs ---------- */
  "include": ["src", "manifest.json"],
  "exclude": [
    "node_modules",
    "src/**/*.test.*",
    "src/**/__tests__/**"
  ],

  "references": [{ "path": "./tsconfig.node.json" }]
}
